{
  "name": "yogapopup",
  "version": "0.3.0",
  "private": true,
  "description": "YogaPop Up: sitio estático + videos en Bunny Stream + Supabase (auth, clases, progreso)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "serve . -l 3000",
    "build": "node scripts/build-site.mjs",
    "preview": "npm run build && serve dist -l 3001",
    "test": "deno test --config supabase/functions/deno.json supabase/functions",
    "lint": "deno lint --config supabase/functions/deno.json supabase/functions",
    "fmt": "deno fmt --config supabase/functions/deno.json supabase/functions",
    "fmt:check": "deno fmt --config supabase/functions/deno.json --check supabase/functions",
    "typecheck": "deno check --config supabase/functions/deno.json \"supabase/functions/*/index.ts\" \"supabase/functions/_tests/*.ts\"",
    "verify": "npm run fmt:check && npm run lint && npm run typecheck && npm run test",
    "sb": "node scripts/supabase.mjs",
    "sb:login": "supabase login",
    "sb:link": "node scripts/supabase.mjs link",
    "sb:db-push": "node scripts/supabase.mjs db-push",
    "sb:secrets": "node scripts/supabase.mjs secrets",
    "sb:deploy": "node scripts/supabase.mjs deploy"
  },
  "devDependencies": {
    "deno": "^2.9.6",
    "serve": "^14.2.6",
    "supabase": "^2.117.0"
  }
}
